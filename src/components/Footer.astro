---
const nav = [
  { href: '#services', label: 'Услуги и цены' },
  { href: '#courts', label: 'Корты' },
  { href: '#coaches', label: 'Тренеры' },
  { href: '#events', label: 'Турниры' },
  { href: '#booking', label: 'Запись на корт' },
];
---
<footer class="bg-night">
  <div class="wrap grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-heading text-lg font-bold text-bone">На кортах<span class="text-lime">.</span></p>
      <p class="mt-3 max-w-xs text-sm text-mist">
        Школа тенниса и падел-клуб в Краснодаре. Венецианская ул., 12/1 — Немецкая деревня.
      </p>
      <p class="mt-4 text-sm text-mist">Ежедневно с 08:00 до 22:00</p>
    </div>
    <nav aria-label="Разделы сайта">
      <p class="font-heading text-sm font-bold uppercase tracking-[0.18em] text-bone">Разделы</p>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-mist transition-colors hover:text-lime">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="font-heading text-sm font-bold uppercase tracking-[0.18em] text-bone">Связь</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="tel:+79182757666" class="text-mist transition-colors hover:text-lime">+7 (918) 275-76-66</a></li>
        <li><a href="https://t.me/na_kortah_krd" class="text-mist transition-colors hover:text-lime">Telegram @na_kortah_krd</a></li>
        <li><a href="https://yandex.ru/maps/?text=Краснодар%2C%20Венецианская%20улица%2C%2012%2F1" class="text-mist transition-colors hover:text-lime">Открыть на карте</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap border-t border-bone/10 py-6 text-xs text-mist">
    © 2026 На кортах. Школа тенниса и падел-клуб, Краснодар.
  </div>
</footer>
