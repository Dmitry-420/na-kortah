---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '#services', label: 'Услуги' },
  { href: '#courts', label: 'Корты' },
  { href: '#coaches', label: 'Тренеры' },
  { href: '#events', label: 'Турниры' },
  { href: '#booking', label: 'Запись' },
];
---
<header class="sticky top-0 z-50 border-b border-bone/10 bg-night/85 backdrop-blur">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a href={base || '/'} class="font-heading text-base font-bold text-bone sm:text-lg">
      На кортах<span class="text-lime">.</span>
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Основная навигация">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-semibold text-mist transition-colors hover:text-lime">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="tel:+79182757666" class="hidden text-sm font-bold text-bone hover:text-lime sm:block">
        +7 (918) 275-76-66
      </a>
      <a href="#booking" class="btn btn-primary px-5 py-2.5 text-sm">Записаться</a>
    </div>
  </div>
</header>